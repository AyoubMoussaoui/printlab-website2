# PRINT LAB Trier: Apache settings for netcup webhosting (Plesk).
# HTTP → HTTPS is handled by Plesk ("Permanent SEO-safe 301 redirect").

ErrorDocument 404 /404.html
AddType application/manifest+json .webmanifest
AddType image/x-icon .ico
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One address only: www.printlab-trier.de → printlab-trier.de
  RewriteCond %{HTTP_HOST} ^www\.printlab-trier\.de$ [NC]
  RewriteRule ^ https://printlab-trier.de%{REQUEST_URI} [R=301,L]

  # Server-side review code and data are not public
  RewriteRule ^(inc|data)(/|$) - [R=404,L]

  # The review form moved to the reviews page (opens the form directly)
  RewriteRule ^bewertung\.html$ /bewertungen#bewerten [R=301,NE,L]

  # iPhones (link previews in iMessage/WhatsApp, home screen) look for the
  # icon at these fixed root addresses; serve the real one from assets/icons
  RewriteRule ^apple-touch-icon(-[0-9]+x[0-9]+)?(-precomposed)?\.png$ assets/icons/apple-touch-icon.png [L]

  # Clean addresses without .html: /index.html → /, /zahlung.html → /zahlung
  # (THE_REQUEST is the browser's request, so the internal rewrite below
  # does not loop back here; query strings are kept)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,NE,L]

  # …and serve /zahlung from zahlung.html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)$ $1.html [L]

  # Repository files that are not part of the website
  # (dot files and folders except .well-known, which Let's Encrypt uses)
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]
  RewriteRule ^README\.md$ - [R=404,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Browsers use HTTPS only for this domain (one year)
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # Only the site's own scripts, styles, fonts and images; no inline scripts.
  # blob: for the photo previews in the claim form, data: for small CSS icons.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

# Caching. CSS and JS links carry a ?v= fingerprint that changes with
# every edit, so browsers may keep them long. Pages are always re-checked.
# Compress text files (HTML, CSS, JS, JSON, SVG) on the way to the browser:
# about a quarter of the size, so pages load faster on mobile networks
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml image/x-icon
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
